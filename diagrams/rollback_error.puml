@startuml
skinparam BoxPadding 10
autonumber

actor "Cajero (POS)" as POS

box "Capa de Presentación & Enrutamiento" #LightCyan
    participant "API Gateway" as API
end box

box "Capa de Lógica de Negocio (Microservicios)" #LightYellow
    participant "Microservicio\nde Ventas" as Ventas
    participant "Microservicio\nde Inventario" as Inventario
    participant "Microservicio\nde Contabilidad" as Contabilidad
end box

box "Capa de Persistencia de Datos" #LightGreen
    database "MongoDB\n(Catálogo/Stock)" as DB_NoSQL
    database "PostgreSQL\n(Facturación)" as DB_SQL
end box

POS -> API: POST /api/v1/orden\nPayload: {item: "Hamburguesa", cant: 1}
activate API
API -> Ventas: Enrutar petición de venta
activate Ventas

Ventas -> Inventario: Validar y descontar stock (1 pan, 150g carne, 1 queso)
activate Inventario
Inventario -> DB_NoSQL: Actualizar stock (Descontar insumos)
activate DB_NoSQL
DB_NoSQL --> Inventario: Confirmación de actualización
deactivate DB_NoSQL
Inventario --> Ventas: 200 OK - Insumos descontados
deactivate Inventario

Ventas -> Contabilidad: Registrar ingreso ($25.000) e Impuestos
activate Contabilidad
Contabilidad -> DB_SQL: Insertar Factura (BEGIN TRANSACTION)
activate DB_SQL

alt PostgreSQL disponible
    DB_SQL --> Contabilidad: Transacción confirmada (COMMIT)
    deactivate DB_SQL
    Contabilidad --> Ventas: 200 OK - Registro contable exitoso
    deactivate Contabilidad
    Ventas --> API: Orden procesada en todos los dominios
    API --> POS: 201 Created - Factura #0001 Generada exitosamente
else Error 500 - PostgreSQL no disponible
    DB_SQL --> Contabilidad: Error de conexión (ROLLBACK automático)
    deactivate DB_SQL
    Contabilidad --> Ventas: 500 Internal Server Error
    deactivate Contabilidad
    note right of Ventas: Patrón de Compensación (Rollback distribuido)
    Ventas -> Inventario: Compensar: "La venta falló,\nvuelve a sumar el pan y la carne al sistema"
    activate Inventario
    Inventario -> DB_NoSQL: Revertir descuento de stock
    activate DB_NoSQL
    DB_NoSQL --> Inventario: Stock restaurado
    deactivate DB_NoSQL
    Inventario --> Ventas: 200 OK - Insumos restaurados
    deactivate Inventario
    Ventas --> API: 500 - Venta no procesada, stock restaurado
    API --> POS: 500 - No se pudo generar la factura, intente de nuevo
end

deactivate Ventas
deactivate API
@enduml
